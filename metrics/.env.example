# Copy this to .env.local and fill in the values.
# .env.local is gitignored — never commit real keys.

# ---- Supabase ----
# Get these from the Supabase dashboard: Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# The service-role key bypasses RLS — only used server-side for admin
# operations (inserting into ai_usage after a metered call). Keep it
# out of anything that ships to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---- Anthropic (for the meeting-modal Autofill from screenshot) ----
# Shared org key. Per-user monthly cost is capped via the ai_usage
# table + the /api/generate route middleware.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- Monthly per-user AI spend cap, in cents ($50 default) ----
AI_MONTHLY_CAP_CENTS=5000
